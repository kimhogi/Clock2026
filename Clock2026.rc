IDR_MAIN_MENU MENU
BEGIN
    POPUP "Files"
    BEGIN
        MENUITEM "파일열기...",                     ID_FILES_OPEN
        MENUITEM SEPARATOR
        MENUITEM "파일저장...",                     ID_FILES_SAVE
        MENUITEM "다른 이름으로...",                  ID_FILES_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "끝내기",                         ID_FILES_EXIT
    END
END

IDR_MENU_SPREAD_NEWS MENU
BEGIN
    POPUP "News Spread"
    BEGIN
        POPUP "Sort"
        BEGIN
            MENUITEM "Asc",                         ID_SPREAD_SORT_ASC
            MENUITEM "Desc",                        ID_SPREAD_SORT_DESC
        END
        MENUITEM SEPARATOR
        MENUITEM "Insert Row",                  ID_SPREAD_INSERT_ROW
        MENUITEM "Delete Row",                  ID_SPREAD_DELETE_ROW
        MENUITEM SEPARATOR
        MENUITEM "All Use",                     ID_SPREAD_ALL_USE
        MENUITEM "All Deselect Use",            ID_SPREAD_ALL_DESELECT_USE
        MENUITEM "Invert Use",                  ID_SPREAD_INVERT_USE
        MENUITEM SEPARATOR
        MENUITEM "Clear Sheet",                 ID_SPREAD_CLEAR_SHEET
        MENUITEM "Restore Sheet",               ID_SPREAD_RESTORE_SHEET
    END
END

IDR_MENU_SPREAD_NOTICE MENU
BEGIN
    POPUP "Notice Spread"
    BEGIN
        MENUITEM "Insert Row",                  ID_SPREAD_INSERT_ROW
        MENUITEM "Delete Row",                  ID_SPREAD_DELETE_ROW
        MENUITEM SEPARATOR
        MENUITEM "All Use",                     ID_SPREAD_ALL_USE
        MENUITEM "All Deselect Use",            ID_SPREAD_ALL_DESELECT_USE
        MENUITEM "Invert Use",                  ID_SPREAD_INVERT_USE
        MENUITEM SEPARATOR
        MENUITEM "Clear sheet",                 ID_SPREAD_CLEAR_SHEET
        MENUITEM "Restore sheet",               ID_SPREAD_RESTORE_SHEET
    END
END


